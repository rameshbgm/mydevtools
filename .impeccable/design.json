  "narrative": {
    "northStar": "Active Developer Workbench",
    "overview": "The introduction explains the developer workspace, leads directly to the catalog and illustrates project organization. The user-requested simplification removes the live demo and its entry points, leaving a single-column hero with one primary catalog action. Scope remains LandingMarketing.tsx and its landing-* rules; app workspace styles are independent.",
    "keyCharacteristics": [
      "Direct tool discovery and labeled illustrative project workspaces.",
      "Sora display, Geist reading text and mono data.",
      "Paired light/dark surfaces with visible separation.",
      "Container-responsive layouts and bounded, meaningful motion.",
      "Eight authored introduction languages with direction-aware chrome and left-to-right data."
    ],
    "rules": [
      {
        "name": "The Paired Surface Rule",
        "body": "Switch the complete semantic color set with the introduction's dark state; preserve the relationships between ground, paper, code well, text and dividers.",
        "section": "colors"
      },
      {
        "name": "The Data Face Rule",
        "body": "Use the mono face for payloads and filenames; use Geist for explanations and controls, and Sora for the principal heading hierarchy.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Reserve broad ambient elevation for the illustrative project preview; organize supporting links and explanations with alignment, spacing and dividers.",
        "section": "elevation"
      }
    ],
    "dos": [
      "**Do** keep these rules bounded to the introduction and preserve the workspace's independent styling contract.",
      "**Do** switch light/dark semantic colors together and retain visible keyboard focus.",
      "**Do** use canonical links to the actual tools when extending discovery.",
      "**Do** keep catalog counts derived from the registry; the verified build has 147 tools across 15 categories.",
      "**Do** state the processing boundary: local browser transformations, explicitly triggered network calls to the shown services, and desktop/local runtime for native database/storage access.",
      "**Do** keep illustrative projects labeled and separate from saved browser-local user work.",
      "**Do** provide immediate reduced-motion state changes and keyboard-operable selections.",
      "**Do** localize the complete introduction, preserve technical example data on language changes and keep data direction independent of interface direction.",
      "**Do** allow translated labels to wrap and preserve script-specific heading rhythm."
    ],
    "donts": [
      "**Don't** claim JWT decoding verifies signatures, or imply every tool is offline or network-free.",
      "**Don't** turn introduction-specific panel spacing, composition or motion into workspace-wide rules.",
      "**Don't** reintroduce the removed live demo or add fake terminal activity or invented customer claims.",
      "**Don't** infer full-product multilingual coverage from the eight-language introduction; global localization remains in progress."
    ]
  }
}
