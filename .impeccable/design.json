      "description": "Single-line tool input; the surrounding control owns its border.",
      "html": "<label class=\"ds-field\">Endpoint<input class=\"ds-input\" value=\"https://api.example.com\" /></label>",
      "css": ".ds-field{font-family:var(--font-geist-sans),sans-serif;font-size:12px;line-height:1.65;display:flex;flex-direction:column;gap:8px;color:var(--wb-text-heading);font-weight:550}.ds-input{font-family:var(--font-geist-sans),sans-serif;font-size:12px;line-height:1.65;height:40px;padding:8px 12px;line-height:22px;box-sizing:border-box;min-width:0;width:100%;border:1px solid var(--signal-control-border);border-radius:5px;background:var(--wb-card-bg);color:var(--wb-text-heading);font-weight:400}.ds-input:hover{border-color:var(--wb-accent)}.ds-input:focus{border-color:var(--wb-accent);box-shadow:0 0 0 2px var(--wb-accent-soft)}.ds-input:focus-visible{outline:2px solid var(--wb-focus-ring);outline-offset:3px}"
    },
    {
      "name": "Selected category",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "Catalog category selection with a visible and semantic active state.",
      "html": "<nav aria-label=\"Tool categories\"><button class=\"ds-category\" aria-pressed=\"true\"><span>Formatters</span><span>Browse</span></button></nav>",
      "css": ".ds-category{font-family:var(--font-geist-sans),sans-serif;font-size:12px;line-height:1.65;display:flex;align-items:center;justify-content:space-between;gap:9px;width:100%;min-height:37px;padding:10px 9px;border:0;border-radius:4px;text-align:start;background:var(--wb-accent-soft);color:var(--wb-accent);cursor:pointer}.ds-category:hover,.ds-category:active{background:var(--wb-accent-soft)}.ds-category:focus-visible{outline:2px solid var(--wb-focus-ring);outline-offset:3px}"
    },
    {
      "name": "Technical tag",
      "kind": "chip",
      "refersTo": "tag",
      "description": "Noninteractive technical metadata from the discovery illustration.",
      "html": "<code class=\"ds-tag\">JSON</code>",
      "css": ".ds-tag{font-family:var(--font-geist-mono),monospace;font-size:11px;display:inline-block;padding:5px 9px;border:1px solid var(--wb-card-border);border-radius:4px;color:var(--wb-text-body);background:var(--wb-card-bg);overflow-wrap:anywhere}"
    },
    {
      "name": "Working panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat panel with an inset heading and bounded content.",
      "html": "<section class=\"ds-panel\"><h3>Response</h3><div>Run the tool to inspect its output.</div></section>",
      "css": ".ds-panel{font-family:var(--font-geist-sans),sans-serif;font-size:12px;line-height:1.65;border:1px solid var(--wb-card-border);border-radius:7px;color:var(--wb-text-heading);background:var(--wb-card-bg);box-shadow:none;overflow:hidden}.ds-panel h3{font:550 12px/1.65 var(--font-geist-sans),sans-serif;margin:0;min-height:48px;display:flex;align-items:center;padding:0 18px;background:var(--signal-inset);border-bottom:1px solid var(--wb-card-border)}.ds-panel>div{padding:18px;color:var(--wb-text-body)}"
    },
    {
      "name": "Catalog tool row",
      "kind": "custom",
      "refersTo": "catalog-row",
      "description": "Direct canonical link into a real tool, with a processing boundary.",
      "html": "<a class=\"ds-row\" href=\"/formatters/json-formatter\"><span class=\"ds-copy\"><strong>JSON Formatter</strong><span>Format and inspect JSON data.</span></span><small>On device</small><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></a>",
      "css": ".ds-row{font-family:var(--font-geist-sans),sans-serif;font-size:12px;line-height:1.65;display:flex;align-items:center;gap:16px;padding:19px 10px;border-bottom:1px solid var(--wb-card-border);background:transparent;color:var(--wb-text-heading);text-decoration:none}.ds-copy{display:grid;grid-template-columns:175px minmax(0,1fr);gap:20px;flex:1;min-width:0}.ds-copy strong{font-size:12px;font-weight:550;overflow-wrap:anywhere}.ds-copy>span{font-size:12px;color:var(--wb-text-body)}.ds-row small{font-size:9px;color:var(--wb-text-muted)}.ds-row:hover{background:var(--signal-inset)}.ds-row:active{color:var(--wb-accent)}.ds-row:focus-visible{outline:2px solid var(--wb-focus-ring);outline-offset:3px}@media(max-width:700px){.ds-copy{display:block}.ds-copy>span{display:block;margin-top:5px}.ds-row{gap:12px}}"
    },
    {
      "name": "Carousel next control",
      "kind": "button",
      "refersTo": "carousel-control",
      "description": "Circular discovery control; navigation behavior remains in the component.",
      "html": "<button class=\"ds-next\" aria-label=\"Next tool\"><svg viewBox=\"0 0 24 24\" width=\"16\" height=\"16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.6\" aria-hidden=\"true\"><path d=\"M5 12h14m-5-5 5 5-5 5\"/></svg></button>",
      "css": ".ds-next{display:grid;place-items:center;width:36px;height:36px;padding:0;border:1px solid var(--signal-control-border);border-radius:50%;background:var(--wb-card-bg);color:var(--wb-accent);cursor:pointer}.ds-next:hover:not(:disabled),.ds-next:active{background:var(--wb-accent);border-color:var(--wb-accent);color:var(--signal-action-ink)}.ds-next:disabled{color:var(--wb-text-muted);opacity:.4;cursor:not-allowed}.ds-next:focus-visible{outline:2px solid var(--wb-focus-ring);outline-offset:3px}@media(max-width:620px){.ds-next{width:30px;height:30px}}"
    },
    {
      "name": "Labeled toolbar",
      "kind": "custom",
      "refersTo": "labeled-toolbar",
      "description": "Labels above controls; 40px controls and actions share a baseline, with a full-width primary action and equal secondary columns on mobile.",
      "html": "<div class=\"ds-toolbar\"><label class=\"ds-toolbar-field\">Algorithm<select class=\"ds-toolbar-select\"><option>SHA-256</option><option>SHA-512</option></select></label><div class=\"ds-toolbar-field\"><span id=\"ds-format-label\">Output Format</span><div class=\"ds-toolbar-segmented\" role=\"group\" aria-labelledby=\"ds-format-label\"><label><input type=\"radio\" name=\"ds-output-format\" checked /><span>Hexadecimal</span></label><label><input type=\"radio\" name=\"ds-output-format\" /><span>Base64</span></label></div></div><div class=\"ds-toolbar-actions\"><button class=\"ds-toolbar-primary\">Generate HMAC</button><button>Share</button><button>Send</button></div></div>",
      "css": ".ds-toolbar{display:flex;align-items:flex-end;flex-wrap:wrap;gap:16px;font:12px/1.65 var(--font-geist-sans),sans-serif;color:var(--wb-text-heading)}.ds-toolbar>.ds-toolbar-field{display:flex;flex-direction:column;gap:8px;flex:0 1 auto;min-width:160px;font-weight:550}.ds-toolbar-select{font:inherit;font-weight:400;box-sizing:border-box;width:100%;height:40px;padding:8px 12px;border:1px solid var(--signal-control-border);border-radius:5px;background:var(--wb-card-bg);color:var(--wb-text-heading)}.ds-toolbar-select:hover{border-color:var(--wb-accent)}.ds-toolbar-segmented{display:inline-flex;align-items:stretch;box-sizing:border-box;height:40px;padding:3px;border-radius:5px;background:var(--signal-inset)}.ds-toolbar-segmented label{position:relative;display:flex;cursor:pointer;font-weight:400}.ds-toolbar-segmented input{position:absolute;opacity:0;width:100%;height:100%;margin:0}.ds-toolbar-segmented span{display:flex;align-items:center;min-height:34px;line-height:22px;padding-inline:12px;border-radius:4px;color:var(--wb-text-body)}.ds-toolbar-segmented input:checked+span{background:var(--wb-accent-soft);color:var(--wb-accent)}.ds-toolbar-segmented label:hover span{color:var(--wb-text-heading)}.ds-toolbar-actions{display:flex;align-items:center;flex-wrap:wrap;gap:8px}.ds-toolbar-actions>button{font:550 12px/22px var(--font-geist-sans),sans-serif;box-sizing:border-box;min-height:40px;padding:8px 17px;border:1px solid var(--wb-card-border);border-radius:5px;background:var(--wb-card-bg);color:var(--wb-text-heading);cursor:pointer}.ds-toolbar-actions>.ds-toolbar-primary{background:var(--wb-accent);border-color:var(--wb-accent);color:var(--signal-action-ink)}.ds-toolbar-actions>button:hover{border-color:var(--wb-accent)}.ds-toolbar-actions>button:not(.ds-toolbar-primary):hover{color:var(--wb-accent)}.ds-toolbar :is(select,button):focus-visible,.ds-toolbar-segmented input:focus-visible+span{outline:2px solid var(--wb-focus-ring);outline-offset:3px}@media(max-width:700px){.ds-toolbar>.ds-toolbar-field{flex:1 1 160px}.ds-toolbar-actions{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));flex-basis:100%}.ds-toolbar-actions>button{width:100%}.ds-toolbar-actions>button:first-child{grid-column:1/-1}}"
    }
  ],
  "narrative": {
    "northStar": "Signal",
    "overview": "Signal is the user-approved visual direction for the entire application: home, catalog, tool pages, workspaces, supporting pages and shared overlays. It replaces the former introduction-only identity. Pale slate and navy surfaces, blue actions, compact typography and ruled layouts keep real developer work prominent.\n\nThe reference preview remains a historical decision artifact. Production follows the later approved headline, feature links, randomized tool carousel and integrated catalog. These design documents record the implemented redesign; they do not announce publication of a 2.1 release.",
    "keyCharacteristics": [
      "A coherent paired light/dark semantic palette across custom CSS and Ant Design.",
      "Compact 12px UI copy, aligned controls and larger purposeful headings.",
      "Full-width home with integrated category navigation; working controls lead tool pages.",
      "Real registry-driven discovery, canonical tool links and explicit data boundaries.",
      "Keyboard operation, reduced-motion behavior and eight-language/RTL support are preserved."
    ],
    "rules": [
      {
        "name": "The Paired Surface Rule",
        "body": "Change the complete semantic set together; preserve text, action-foreground, control-border and status relationships in both themes.",
        "section": "colors"
      },
      {
        "name": "The Data Face Rule",
        "body": "Use mono for actual technical data; keep labels and explanatory UI in Geist and the landing display in Sora.",
        "section": "typography"
      },
      {
        "name": "The Working Surface Rule",
        "body": "Keep normal tools and catalog surfaces flat; reserve elevation for layers above the current working context.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use Signal across all application pages while retaining the marketing/workspace source split.",
      "Do use semantic foreground/background pairs and stronger control borders in both themes.",
      "Do keep body, form and navigation text at the shared 12px scale; preserve heading and numerical hierarchy.",
      "Do align normal form controls at 40px, allow long labels to wrap, and collapse grids before fields overlap.",
      "Do keep tool controls above guidance and reference material, with compact network disclosures still available.",
      "Do derive discovery from the real registry and navigate with toolPath or toolPathFromId.",
      "Do preserve existing tools, saved data, bookmark menus, projects and all eight locale choices with RTL support.",
      "Do retain clear pause, focus and reduced-motion behavior for automatic discovery."
    ],
    "donts": [
      "Don't restore duplicate outer home sidebars, an unbounded sticky category list or the removed fixed API call-to-action.",
      "Don't introduce gradients, glass, decorative shadows or fabricated live tool output into Signal discovery.",
      "Don't make network requests or access saved payloads merely to animate a carousel illustration.",
      "Don't mistake the historical three-demo preview for the production tool catalog or its persistence behavior.",
      "Don't describe this implementation or review as a published 2.1 release or comprehensive functional certification of every tool."
    ]
  }
}
