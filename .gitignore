# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# Monaco editor — auto-copied by `npm run copy-monaco` (postinstall hook).
# Self-hosted to avoid cdn.jsdelivr.net runtime fetch.
/public/monaco/

# production
/build
/.desktop/
/desktop-dist/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Read-only source review output (uploaded as a CI artifact)
/reference-source-report.json

# SQLite WebAssembly assets copied from the locked sql.js package.
/public/sqlite/

# ONNX Runtime factories and WASM copied from the locked package.
/public/onnx/

# Local browser QA evidence; design records remain versionable.
/.impeccable/review/
