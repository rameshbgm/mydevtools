{
  "reviewedAt": "2026-10-21",
  "source": "TOON official specification working draft 4.4; independent strict primitive and inline-array decoder fixtures only",
  "sources": [
    {
      "url": "https://raw.githubusercontent.com/toon-format/spec/main/tests/fixtures/decode/primitives.json",
      "blobSha": "b2053e79b086c18a4c2c5a8e58222bbfdd6b2fbc"
    },
    {
      "url": "https://raw.githubusercontent.com/toon-format/spec/main/tests/fixtures/decode/arrays-primitive.json",
      "blobSha": "a92dde39ca0031689df4548f98eeacba2beefeb4"
    }
  ],
  "tests": [
    {
      "name": "parses safe unquoted string",
      "input": "hello",
      "expected": "hello",
      "specSection": "4"
    },
    {
      "name": "parses empty quoted string",
      "input": "\"\"",
      "expected": "",
      "specSection": "4"
    },
    {
      "name": "parses quoted strings with newline, tab, and carriage return escapes",
      "input": "[3]: \"line1\\nline2\",\"tab\\there\",\"return\\rcarriage\"",
      "expected": [
        "line1\nline2",
        "tab\there",
        "return\rcarriage"
      ],
      "specSection": "7.1"
    },
    {
      "name": "parses quoted string with backslash escape",
      "input": "\"C:\\\\Users\\\\path\"",
      "expected": "C:\\Users\\path",
      "specSection": "7.1"
    },
    {
      "name": "parses quoted string with escaped quotes",
      "input": "\"say \\\"hello\\\"\"",
      "expected": "say \"hello\"",
      "specSection": "7.1"
    },
    {
      "name": "closes a quoted token after an escaped backslash",
      "input": "\"a\\\\\"[2]: \"y\\\\\",z",
      "expected": {
        "a\\": [
          "y\\",
          "z"
        ]
      },
      "specSection": "5.2"
    },
    {
      "name": "decodes \\uXXXX escape (U+0004)",
      "input": "val: \"a\\u0004b\"",
      "expected": {
        "val": "a\u0004b"
      },
      "specSection": "7.1"
    },
    {
      "name": "decodes \\uXXXX with mixed-case hex digits",
      "input": "val: \"a\\u00Abb\"",
      "expected": {
        "val": "a«b"
      },
      "specSection": "7.1"
    },
    {
      "name": "parses Unicode string",
      "input": "café",
      "expected": "café",
      "specSection": "16"
    },
    {
      "name": "parses Chinese characters",
      "input": "你好",
      "expected": "你好",
      "specSection": "16"
    },
    {
      "name": "parses string with emoji and spaces",
      "input": "hello 👋 world",
      "expected": "hello 👋 world",
      "specSection": "16"
    },
    {
      "name": "parses positive integer",
      "input": "42",
      "expected": 42,
      "specSection": "4"
    },
    {
      "name": "parses decimal number",
      "input": "3.14",
      "expected": 3.14,
      "specSection": "4"
    },
    {
      "name": "parses negative integer",
      "input": "-7",
      "expected": -7,
      "specSection": "4"
    },
    {
      "name": "parses true",
      "input": "true",
      "expected": true,
      "specSection": "4"
    },
    {
      "name": "parses false",
      "input": "false",
      "expected": false,
      "specSection": "4"
    },
    {
      "name": "parses null",
      "input": "null",
      "expected": null,
      "specSection": "4"
    },
    {
      "name": "respects ambiguity quoting for true",
      "input": "\"true\"",
      "expected": "true",
      "specSection": "4"
    },
    {
      "name": "respects ambiguity quoting for integer",
      "input": "\"42\"",
      "expected": "42",
      "specSection": "4"
    },
    {
      "name": "decodes supplementary scalar (U+1F680) in quoted string as literal UTF-8",
      "input": "\"🚀 launch\"",
      "expected": "🚀 launch",
      "specSection": "7.1"
    },
    {
      "name": "decodes a raw control character inside a quoted string",
      "input": "val: \"x\u0001y\"",
      "expected": {
        "val": "x\u0001y"
      },
      "specSection": "7.1",
      "minSpecVersion": "4.2"
    },
    {
      "name": "parses mixed primitive arrays inline",
      "input": "data[4]: x,y,true,10",
      "expected": {
        "data": [
          "x",
          "y",
          true,
          10
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "parses empty arrays",
      "input": "items[0]:",
      "expected": {
        "items": []
      },
      "specSection": "9.1"
    },
    {
      "name": "parses single-item array with empty string",
      "input": "items[1]: \"\"",
      "expected": {
        "items": [
          ""
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "parses multi-item array with empty string",
      "input": "items[3]: a,\"\",b",
      "expected": {
        "items": [
          "a",
          "",
          "b"
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "parses whitespace-only strings in arrays",
      "input": "items[2]: \" \",\"  \"",
      "expected": {
        "items": [
          " ",
          "  "
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "parses strings with delimiters in arrays",
      "input": "items[3]: a,\"b,c\",\"d:e\"",
      "expected": {
        "items": [
          "a",
          "b,c",
          "d:e"
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "parses strings that look like primitives when quoted",
      "input": "items[4]: x,\"true\",\"42\",\"-3.14\"",
      "expected": {
        "items": [
          "x",
          "true",
          "42",
          "-3.14"
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "parses strings with structural tokens in arrays",
      "input": "items[3]: \"[5]\",\"- item\",\"{key}\"",
      "expected": {
        "items": [
          "[5]",
          "- item",
          "{key}"
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "parses quoted key with inline array",
      "input": "\"my-key\"[3]: 1,2,3",
      "expected": {
        "my-key": [
          1,
          2,
          3
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "parses quoted empty string key with inline array",
      "input": "\"\"[3]: 1,2,3",
      "expected": {
        "": [
          1,
          2,
          3
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "parses quoted key containing a colon with inline array",
      "input": "\"a:b\"[2]: 1,2",
      "expected": {
        "a:b": [
          1,
          2
        ]
      },
      "specSection": "9.1"
    },
    {
      "name": "decodes canonical empty array key: []",
      "input": "items: []",
      "expected": {
        "items": []
      },
      "specSection": "9.1"
    },
    {
      "name": "parses quoted key containing escaped quotes and brackets with inline array",
      "input": "\"has \\\"[2]\\\" in it\"[3]: 3,4,5",
      "expected": {
        "has \"[2]\" in it": [
          3,
          4,
          5
        ]
      },
      "specSection": "9.1",
      "note": "An escaped quote does not close a quoted key, so the [2] inside it is not a bracket segment"
    },
    {
      "name": "decodes the inline element [] as a string, not an empty array",
      "input": "a[1]: []",
      "expected": {
        "a": [
          "[]"
        ]
      },
      "specSection": "9.3"
    }
  ]
}
